		<table>
			<thead>
				<tr><th>Tag</th><th>Mô tả</th><th>Số câu hỏi</th><th></th></tr>
			</thead>
			<tbody>
				{#each tags as t}
					<tr>
						<td>{t.name}</td>
						<td>{t.description || '—'}</td>
						<td>{t.questionCount}</td>
						<td>
							<button onclick={() => editTagDescription(t)}>Sửa</button>
							<button class="danger" onclick={() => removeTag(t)}>Xóa</button>
						</td>
					</tr>
