				<button class="btn-cancel" onclick={() => (showCloseModal = false)}>Hủy</button>
				<button class="btn-confirm danger" onclick={submitCloseQuestion}>Xác nhận đóng</button>
			</div>
		</div>
	</div>
{/if}

